<UserControl x:Class="QuickLook.Plugin.StepViewer.StepViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="#1A1A1A">
    <Grid>
        <!-- Microsoft Edge WebView2 Hosting Three.js CAD Viewport -->
        <wv2:WebView2 x:Name="WebViewControl" Focusable="False" />

        <!-- Initial Startup Loading Overlay -->
        <Border x:Name="LoadingOverlay" Background="#1A1A1A" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Background="#2B2B2B" Foreground="#0078D4" BorderThickness="0" Margin="0,0,0,16"/>
                <TextBlock x:Name="TxtLoadingStatus" Text="Initializing 3D CAD Engine..." Foreground="#A0A0A0" FontSize="14" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Visual Error Overlay (Prevents dead black screen) -->
        <Border x:Name="ErrorOverlay" Background="#E61A1A1A" Visibility="Collapsed" Padding="32">
            <Border Background="#242424" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="28" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="✕" Foreground="#EF4444" FontSize="20" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CAD Viewer Notice" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtErrorMessage" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="20" FontFamily="Segoe UI"/>
                    <Button x:Name="BtnDownloadWebView2" Content="Download Microsoft Edge WebView2" Visibility="Collapsed" Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="16,8" Cursor="Hand" Click="BtnDownloadWebView2_Click" BorderThickness="0" HorizontalAlignment="Left">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- Large File Guardrail Overlay (>35MB) -->
        <Border x:Name="GuardrailOverlay" Background="#E61A1A1A" Visibility="Collapsed" Padding="32">
            <Border Background="#242424" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="8" Padding="28" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Large CAD Model Notice" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <TextBlock Text="This STEP file is larger than 35 MB. Tessellating large assemblies in WebAssembly may require high memory and take several seconds to compute." 
                               Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="20" FontFamily="Segoe UI"/>

                    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,22">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="File:" Foreground="#64748B" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtMetaFileName" Grid.Column="1" Text="-" Foreground="#E2E8F0" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Size:" Foreground="#64748B" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtMetaFileSize" Grid.Column="1" Text="-" Foreground="#E2E8F0" FontSize="12" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Schema:" Foreground="#64748B" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtMetaSchema" Grid.Column="1" Text="-" Foreground="#E2E8F0" FontSize="12" FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Software:" Foreground="#64748B" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxtMetaSoftware" Grid.Column="1" Text="-" Foreground="#E2E8F0" FontSize="12" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnRenderLargeModel" Content="Render 3D Model" Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="13" Padding="20,10" Cursor="Hand" Click="BtnRenderLargeModel_Click" BorderThickness="0" HorizontalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
